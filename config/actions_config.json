            "category": "interaction"
        },
        "fill": {
            "display_name": "Fill (nhap text)",
            "playwright_method": "page.fill",
            "needs_selector": true,
            "needs_value": true,
            "params": {},
            "log_message": "Nhap '{value}' vao: {name}",
            "category": "interaction"
        },
        "fill_password": {
            "display_name": "Fill Password",
            "playwright_method": "page.fill",
            "needs_selector": true,
            "needs_value": true,
            "params": {},
            "log_message": "Nhap mat khau vao: {name}",
            "category": "interaction"
        },
        "check": {
            "display_name": "Check (checkbox)",
            "playwright_method": "page.check",
            "needs_selector": true,
            "needs_value": false,
            "params": {},
            "log_message": "Check: {name}",
            "category": "interaction"
        },
        "uncheck": {
            "display_name": "Uncheck (checkbox)",
            "playwright_method": "page.uncheck",
            "needs_selector": true,
            "needs_value": false,
            "params": {},
            "log_message": "Uncheck: {name}",
            "category": "interaction"
        },
        "hover": {
            "display_name": "Hover",
            "playwright_method": "page.hover",
            "needs_selector": true,
            "needs_value": false,
            "params": {},
            "log_message": "Hover len: {name}",
            "category": "interaction"
        },
        "press": {
            "display_name": "Press (nhan phim)",
            "playwright_method": "page.press",
            "needs_selector": true,
            "needs_value": true,
            "params": {
                "key": {
                    "type": "str",
                    "description": "Phim can nhan (VD: Enter, Tab, ArrowDown)"
                }
            },
            "log_message": "Nhan phim '{value}' tai: {name}",
            "category": "interaction"
        },
        "type": {
            "display_name": "Type (go tung ky tu)",
            "playwright_method": "page.type",
            "needs_selector": true,
            "needs_value": true,
            "params": {
                "delay": {
                    "type": "float",
                    "description": "Do tre giua cac ky tu (ms)",
                    "default": 0
                }
            },
            "log_message": "Go '{value}' vao: {name}",
            "category": "interaction"
        },
        "select": {
            "display_name": "Select Option",
            "playwright_method": "page.select_option",
            "needs_selector": true,
            "needs_value": true,
            "params": {},
            "log_message": "Chon option '{value}' tai: {name}",
            "category": "interaction"
        },
        "set_input_files": {
            "display_name": "Upload file",
            "playwright_method": "page.set_input_files",
            "needs_selector": true,
            "needs_value": true,
            "params": {},
            "log_message": "Upload file '{value}' tai: {name}",
            "category": "interaction"
        },
        "verify_text": {
            "display_name": "Verify Text (kiem tra noi dung)",
            "playwright_method": "page.inner_text",
            "needs_selector": true,
            "needs_value": true,
            "params": {},
            "log_message": "Kiem tra van ban: Ky vong chua '{value}', thuc te co '{actual}'",
            "assertion": "text_contains",
            "category": "verification"
        },
        "verify_visible": {
            "display_name": "Verify Visible (kiem tra hien thi)",
            "playwright_method": "page.is_visible",
            "needs_selector": true,
            "needs_value": false,
            "params": {},
            "log_message": "Kiem tra hien thi: {name}",
            "assertion": "is_visible",
            "category": "verification"
        },
        "verify_url": {
            "display_name": "Verify URL",
            "playwright_method": "page.url",
            "needs_selector": false,
            "needs_value": true,
            "params": {},
            "log_message": "Kiem tra URL chua: '{value}'",
            "assertion": "url_contains",
            "category": "verification"
        },
        "wait": {
            "display_name": "Wait (cho)",
            "playwright_method": "page.wait_for_timeout",
            "needs_selector": false,
            "needs_value": true,
            "params": {},
            "log_message": "Cho trong {value}ms...",
            "category": "utility"
        },
        "wait_for_selector": {
            "display_name": "Wait for Element",
            "playwright_method": "page.wait_for_selector",
            "needs_selector": true,
            "needs_value": false,
            "params": {
                "state": {
                    "type": "str",
                    "description": "Trang thai: attached/detached/hidden/visible",
                    "default": "visible"
                },
                "timeout": {
                    "type": "float",
                    "description": "Thoi gian cho toi da (ms)",
                    "default": 10000
                }
            },
            "log_message": "Cho phan tu: {name}",
            "category": "utility"
        },
        "navigate": {
            "display_name": "Navigate (dieu huong)",
            "playwright_method": "page.goto",
            "needs_selector": false,
            "needs_value": true,
            "params": {},
            "log_message": "Dieu huong toi: {value}",
            "category": "utility"
        }
    },
    "playwright_functions": {
